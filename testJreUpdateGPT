@Test
void shouldCreateNewJreImageJsonAndPush_whenNewVersionAvailable() throws Exception {
    // Given
    String githubAuthToken = "dummyToken";
    String currentVersion = "openjdk 17.0.1 2025-01-21 LTS";
    String lastVersion = "openjdk 17.0.0 2024-11-15 LTS";
    String extractedVersion = "17.0.1";
    List<String> latestAlpineTags = List.of("latest", "3.21.3", "3.21", "3");
    AlpineImageInfoDto.Platform platform = new AlpineImageInfoDto.Platform();
    platform.setArchitecture("amd64");
    AlpineImageInfoDto dto = new AlpineImageInfoDto();
    dto.setPlatform(platform);

    Path fakeJdkHome = Path.of("/fake/jdk");

    // Mocking dependencies
    when(jreService.downloadAndExtractJDK(anyString())).thenReturn(null);
    when(githubService.getLastJreImageVersion(githubAuthToken)).thenReturn(lastVersion);
    when(githubService.getLastImageTags(githubAuthToken)).thenReturn(latestAlpineTags);
    when(githubService.getAlpineManifest(githubAuthToken)).thenReturn(dto);
    when(jreUpdateChecker.findJdkHome(any())).thenReturn(fakeJdkHome);
    when(jreUpdateChecker.getJavaVersion(any())).thenReturn(currentVersion);

    // When
    jreUpdateChecker.checkJreUpdate(githubAuthToken);

    // Then
    verify(githubService).pushNewJreImageFileToRepo(githubAuthToken);
    File file = new File("new-jre-image.json");
    assertTrue(file.exists());
}
