package com.ncratleos.baseimage.service;

import org.junit.jupiter.api.Test;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

import static org.junit.jupiter.api.Assertions.*;

class JreServiceTest {

    private final JreService jreService = new JreService();

    @Test
    void shouldCreateOutputDirectory_whenDownloadAndExtractJDKIsCalled() throws IOException {
        // Arrange
        Path tempOutputDir = Files.createTempDirectory("jdk-test");

        // Act & Assert
        try {
            jreService.downloadAndExtractJDK(tempOutputDir.toString());

            // Check that the output directory still exists (was created)
            assertTrue(Files.exists(tempOutputDir));
        } catch (IOException e) {
            fail("downloadAndExtractJDK should not throw an exception: " + e.getMessage());
        }
    }
}
