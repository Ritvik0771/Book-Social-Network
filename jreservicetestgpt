package com.ncratleos.baseimage.service;

import org.apache.commons.compress.archivers.tar.TarArchiveEntry;
import org.apache.commons.compress.archivers.tar.TarArchiveOutputStream;
import org.apache.commons.compress.compressors.gzip.GzipCompressorOutputStream;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;
import org.mockito.Mockito;

import java.io.*;
import java.net.URL;
import java.nio.file.Files;
import java.nio.file.Path;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

class JreServiceTest {

    @Test
    void testDownloadAndExtractJDK(@TempDir Path tempDir) throws Exception {
        // Step 1: Prepare fake .tar.gz file in memory
        Path fakeTarGz = Files.createTempFile("test-jdk", ".tar.gz");
        createFakeTarGz(fakeTarGz);

        // Step 2: Spy JreService and mock the download step
        JreService jreService = Mockito.spy(new JreService());

        doReturn(new FileInputStream(fakeTarGz.toFile()))
                .when(jreService)
                .downloadJdkFile(anyString());

        // Step 3: Inject a testable version of downloadAndExtractJDK
        jreService.downloadAndExtractJDK(tempDir.toString());

        // Step 4: Assert that the extracted content exists
        assertTrue(Files.exists(tempDir.resolve("testdir/hello.txt")));
        assertEquals("Hello JDK\n", Files.readString(tempDir.resolve("testdir/hello.txt")));
    }

    /**
     * Creates a small fake tar.gz with a single file for test purposes.
     */
    private void createFakeTarGz(Path outputPath) throws IOException {
        try (
                FileOutputStream fos = new FileOutputStream(outputPath.toFile());
                GzipCompressorOutputStream gzipOut = new GzipCompressorOutputStream(fos);
                TarArchiveOutputStream tarOut = new TarArchiveOutputStream(gzipOut)
        ) {
            // Simulate a folder and a file inside it
            TarArchiveEntry dirEntry = new TarArchiveEntry("testdir/");
            dirEntry.setMode(0755);
            tarOut.putArchiveEntry(dirEntry);
            tarOut.closeArchiveEntry();

            byte[] content = "Hello JDK\n".getBytes();
            TarArchiveEntry fileEntry = new TarArchiveEntry("testdir/hello.txt");
            fileEntry.setSize(content.length);
            tarOut.putArchiveEntry(fileEntry);
            tarOut.write(content);
            tarOut.closeArchiveEntry();

            tarOut.finish();
        }
    }
}
